HOST_FRONTEND_HTTPS_PORT=443
ENABLE_TLS=true
SERVER_NAME=ghosttalk.home.arpa
LIVEKIT_SERVER_NAME=livekit.ghosttalk.home.arpa
TLS_CERTS_DIR=./certs
LIVEKIT_URL=wss://livekit.ghosttalk.home.arpa
MEDIA_TOPOLOGY=dual
LIVEKIT_API_KEY=ghosttalk-lan
LIVEKIT_API_SECRET=replace-with-generated-secret
CSP_CONNECT_SRC="'self' https://ghosttalk.home.arpa wss://livekit.ghosttalk.home.arpa"
INTERNAL_WORKER_TOKEN=replace-with-a-long-random-worker-secret
ANALYSIS_URL=
ANALYSIS_API_KEY=
ANALYSIS_MODEL=
TRANSCRIPT_RETENTION=720h
CORS_ALLOWED_ORIGINS=https://ghosttalk.home.arpa
